#!/usr/bin/env bash

if [ "$#" -ne 1 ]; then
	echo "Usage: $0 <directory_name>"
	exit 1
fi

DIR_NAME="$1"
TARGET_DIR="$HOME/$DIR_NAME"

if [ ! -d "$TARGET_DIR" ]; then
	mkdir -p "$TARGET_DIR"
fi

REMAINING_COUNT=0

for file in *; do
	if [ -f "$file" ]; then
		if [ -r "$file" ] && [ -w "$file" ]; then
			cp "$file" "$TARGET_DIR/"
		else
			((REMAINING_COUNT++))
		fi
	fi
done

echo "The number of remaining files is: $REMAINING_COUNT"
